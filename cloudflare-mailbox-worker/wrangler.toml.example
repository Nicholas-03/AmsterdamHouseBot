name = "amsterdam-house-mailbox"
main = "src/index.js"
compatibility_date = "2026-05-28"

workers_dev = true

[vars]
MAILBOX_ADDRESS = "housing@example.com"
MAILBOX_RETENTION_DAYS = "14"
# Optional: forward a human-readable copy after saving it for the bot.
# FORWARD_TO = "you@example.com"
# Pararius+ alerts are not re-forwarded by default to avoid Gmail -> Worker -> Gmail loops.
# FORWARD_SKIP_PARARIUS_PLUS = "1"

[[kv_namespaces]]
binding = "MAILBOX"
id = "replace-with-kv-namespace-id"
